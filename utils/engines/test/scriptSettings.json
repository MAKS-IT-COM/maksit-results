{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "Run Tests Script Settings",
  "description": "Template: plugin-driven tests and coverage badges. Product repos override this file via Update-RepoUtils preserve.",
  "plugins": [
    {
      "name": "DotNetTest",
      "stageLabel": "test",
      "enabled": true,
      "projects": [
        "..\\..\\..\\src\\MaksIT.Results.Tests"
      ],
      "resultsDir": "..\\..\\..\\test-results"
    },
    {
      "name": "QualityGate",
      "stageLabel": "qualityGate",
      "enabled": true,
      "coverageThreshold": 0,
      "scanVulnerabilities": false
    },
    {
      "name": "CoverageBadges",
      "stageLabel": "report",
      "enabled": true,
      "badgeFormat": "shields",
      "readmePath": "..\\..\\..\\README.md",
      "badges": [
        {
          "label": "Line Coverage",
          "metric": "line"
        },
        {
          "label": "Branch Coverage",
          "metric": "branch"
        },
        {
          "label": "Method Coverage",
          "metric": "method"
        }
      ],
      "colorThresholds": {
        "brightgreen": 80,
        "green": 60,
        "yellowgreen": 40,
        "yellow": 20,
        "orange": 10,
        "red": 0
      }
    }
  ],
  "paths": {
    "readmePath": "..\\..\\..\\README.md",
    "testResultsDir": "..\\..\\..\\test-results"
  }
}
